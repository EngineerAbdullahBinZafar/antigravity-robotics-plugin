<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="antigravity_thruster_bot">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>12.5</mass>
        <inertia>
          <ixx>0.45</ixx>
          <iyy>0.45</iyy>
          <izz>0.45</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <!-- Central Hexagonal Core Chassis -->
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>0.6 0.6 0.35</size>
          </box>
        </geometry>
      </collision>

      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>0.6 0.6 0.35</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.12 0.18 1</ambient>
          <diffuse>0.16 0.18 0.26 1</diffuse>
          <specular>0.8 0.9 1.0 1</specular>
        </material>
      </visual>

      <!-- Antigravity Field Emitter Array Visual Ring (Neon Cyan) -->
      <visual name="emitter_ring">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0.9 1 1</ambient>
          <diffuse>0 0.94 1 1</diffuse>
          <emissive>0 0.8 1 1</emissive>
        </material>
      </visual>

      <!-- 360 Degree 2D/3D LiDAR Sensor -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.22 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>25.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <visualize>false</visualize>
      </sensor>

      <!-- High-Precision IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <topic>/imu</topic>
        <update_rate>100</update_rate>
      </sensor>
    </link>

    <!-- 6-DOF Force Plugin for Zero-G Thrust Actuation -->
    <plugin
      filename="ignition-gazebo-apply-link-wrench-system"
      name="ignition::gazebo::systems::ApplyLinkWrench">
      <link_name>base_link</link_name>
    </plugin>
  </model>
</sdf>
